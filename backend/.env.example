# ============================================================
# NubeStore Backend - Variables de entorno (PLANTILLA)
# ============================================================
# 1. Copia este archivo como ".env" en la misma carpeta.
# 2. Rellena los valores reales.
# 3. NUNCA subas el archivo ".env" a Git (ya está en .gitignore).
# ============================================================

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/nubestore_db
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui

# CORS - orígenes permitidos del frontend (separados por coma)
CORS_ORIGINS=http://localhost:63342,http://127.0.0.1:63342
